---
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
import Ubicacion from './sections/Ubicacion.astro';
import DateBar from './booking/DateBar.astro';
import { useTranslations, BOOKING_URL } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/home.css';

// Slots de imagen gestionados por el editor de fotos (npm run editor).
import heroImg from '../assets/images/slots/hero.jpeg';
import aboutImg from '../assets/images/slots/about.jpeg';
import kingImg from '../assets/images/slots/room-standard.jpeg';
import queenImg from '../assets/images/slots/room-deluxe.jpeg';
import execImg from '../assets/images/slots/room-exec.jpeg';
import cornerImg from '../assets/images/slots/room-corner.jpeg';

const lang = Astro.props.lang as Lang;
const t = useTranslations(lang);

const amenities = ['pool', 'fitness', 'dining', 'business', 'parking', 'wifi', 'transfer', 'concierge'] as const;
// Nombres y precios reales de habitaciones (Precios habitaciones.txt, 2026-07-24).
// Fotos provisionales — reemplazar con el editor de fotos cuando lleguen las definitivas.
const rooms = [
  { key: 'king',   img: kingImg,   badge: false },
  { key: 'queen',  img: queenImg,  badge: false },
  { key: 'exec',   img: execImg,   badge: false },
  { key: 'corner', img: cornerImg, badge: true  },
] as const;
---
<!-- HERO -->
<section class="hero" id="hero">
  <div class="hero-bg">
    <Image src={heroImg} alt={lang === 'es' ? 'Global Hotel Panamá sobre el skyline de Obarrio' : 'Global Hotel Panama above the Obarrio skyline'} loading="eager" fetchpriority="high" widths={[768, 1280, 1920]} sizes="100vw" />
  </div>
  <div class="hero-scrim"></div>
  <div class="hero-content">
    <p class="hero-eyebrow">{t('hero.eyebrow')}</p>
    <h1 class="hero-title">{t('hero.title.a')}<br /><em>{t('hero.title.b')}</em><br />{t('hero.title.c')}</h1>
    <p class="hero-desc">{t('hero.desc')}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">{t('hero.book')}</a>
      <a class="btn btn-ghost" href="#about">{t('hero.discover')}</a>
    </div>
  </div>
  <div class="hero-scroll">{t('hero.scroll')}</div>
</section>

<!-- BARRA DE FECHAS (deep link al motor e-gds) -->
<DateBar lang={lang} />
<DateBar lang={lang} sticky />

<!-- STATS (contadores animados — detalle de Stitch) -->
<div class="stats-bar" id="stats">
  <div class="stat-item"><div class="stat-num"><span class="num" data-count="60">60</span></div><div class="stat-label">{t('stat.rooms')}</div></div>
  <div class="stat-item"><div class="stat-num"><span class="num" data-count="24">24</span>h</div><div class="stat-label">{t('stat.access')}</div></div>
  <div class="stat-item"><div class="stat-num"><span class="num" data-count="22">22</span>km</div><div class="stat-label">{t('stat.airport')}</div></div>
  <!-- TODO(juan): tarifa mínima unificada a $98 (rooms.txt). El sitio actual muestra $110+. Confirmar. -->
  <div class="stat-item"><div class="stat-num">$<span class="num" data-count="98">98</span></div><div class="stat-label">{t('stat.night')}</div></div>
</div>

<!-- ABOUT -->
<section class="section" id="about">
  <div class="container">
    <div class="about-inner">
      <div class="about-image reveal">
        <Image src={aboutImg} alt={lang === 'es' ? 'Interior del Global Hotel Panamá' : 'Global Hotel Panama interior'} loading="lazy" widths={[500, 800]} sizes="(max-width:860px) 100vw, 46vw" />
      </div>
      <div>
        <p class="section-eyebrow reveal">{t('about.eyebrow')}</p>
        <h2 class="section-title reveal">{t('about.title.a')}<em>{t('about.title.b')}</em></h2>
        <p class="section-desc reveal">{t('about.p1')}</p>
        <p class="section-desc reveal" style="margin-top:-20px">{t('about.p2')}</p>
        <div class="about-details reveal">
          <div class="about-detail-item"><strong>{t('about.d1s')}</strong><span>{t('about.d1l')}</span></div>
          <div class="about-detail-item"><strong>{t('about.d2s')}</strong><span>{t('about.d2l')}</span></div>
          <div class="about-detail-item"><strong>{t('about.d3s')}</strong><span>{t('about.d3l')}</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AMENITIES -->
<section class="section dark" id="amenities">
  <div class="container">
    <p class="section-eyebrow reveal">{t('amen.eyebrow')}</p>
    <h2 class="section-title reveal">{t('amen.title.a')}<em>{t('amen.title.b')}</em></h2>
    <div class="amen-grid">
      {amenities.map((a, i) => (
        <div class={`amen-card reveal reveal-d${(i % 4) + 1}`}>
          <span class="icon"><Icon name={a} /></span>
          <h3>{t(`amen.${a}` as any)}</h3>
          <p>{t(`amen.${a}.d` as any)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ROOMS — slider de 4 tarjetas con precio rack tachado y precio promo -->
<section class="section" id="rooms">
  <div class="container">
    <div class="rooms-header">
      <div>
        <p class="section-eyebrow reveal">{t('rooms.eyebrow')}</p>
        <h2 class="section-title reveal">{t('rooms.title.a')}<em>{t('rooms.title.b')}</em></h2>
      </div>
      <p class="section-desc reveal">{t('rooms.desc')}</p>
    </div>
    <div class="rooms-slider-wrap reveal">
      <div class="rooms-track" id="roomsTrack">
        {rooms.map((r) => (
          <div class="room-card">
            <div class="room-image">
              <Image src={r.img} alt={t(`rooms.${r.key}` as any)} loading="lazy" widths={[400, 640]} sizes="(max-width:860px) 88vw, 31vw" />
              {r.badge && <div class="room-badge gold">{t('rooms.badge')}</div>}
            </div>
            <div class="room-body">
              <p class="room-cat">{t(`rooms.${r.key}.cat` as any)}</p>
              <h3>{t(`rooms.${r.key}` as any)}</h3>
              <div class="meta">{t(`rooms.${r.key}.meta` as any)}</div>
              <div class="price">
                <span class="price-rack">${t(`rooms.${r.key}.rack` as any)}</span>
                <strong class="price-promo">${t(`rooms.${r.key}.promo` as any)}</strong>
                <span class="price-night">{t('rooms.night')}</span>
              </div>
              <span class="price-taxes">{t('rooms.taxes')}</span>
              <a class="btn-room" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">{t('rooms.reserve')}</a>
            </div>
          </div>
        ))}
      </div>
      <div class="slider-controls">
        <button class="slider-btn" id="roomsPrev" aria-label="Anterior" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="slider-dots" id="roomsDots"></div>
        <button class="slider-btn" id="roomsNext" aria-label="Siguiente" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- OFFERS -->
<section class="section dark" id="offers">
  <div class="container">
    <p class="section-eyebrow reveal">{t('offers.eyebrow')}</p>
    <h2 class="section-title reveal">{t('offers.title.a')}<em>{t('offers.title.b')}</em></h2>
    <p class="section-desc reveal">{t('offers.desc')}</p>
    <div class="offer-grid">
      <div class="offer-card reveal">
        <div class="offer-tag">{t('offer.ext.tag')}</div>
        <h3>{t('offer.ext.title')}</h3><p>{t('offer.ext.desc')}</p>
        <a class="btn-offer" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">{t('offer.book')}</a>
      </div>
      <div class="offer-card reveal reveal-d2">
        <div class="offer-tag">{t('offer.wknd.tag')}</div>
        <h3>{t('offer.wknd.title')}</h3><p>{t('offer.wknd.desc')}</p>
        <a class="btn-offer" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">{t('offer.book')}</a>
      </div>
      <div class="offer-card reveal reveal-d3">
        <div class="offer-tag">{t('offer.corp.tag')}</div>
        <h3>{t('offer.corp.title')}</h3><p>{t('offer.corp.desc')}</p>
        <a class="btn-offer" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">{t('offer.book')}</a>
      </div>
    </div>
  </div>
</section>

<!-- LOCATION · sección Ubicación aprobada (dirección con acción, distancias agrupadas, mapa diferido) -->
<Ubicacion lang={lang} />

<!-- REVIEWS · números reales (§3). TODO(juan): confirmar citas o sustituir por reseñas reales de Google. -->
<section class="section dark" id="reviews">
  <div class="container">
    <p class="section-eyebrow reveal">{t('rev.eyebrow')}</p>
    <h2 class="section-title reveal">{t('rev.title.a')}<em>{t('rev.title.b')}</em></h2>
    <div class="rev-grid">
      <div class="rev-card reveal">
        <span class="rev-stars" aria-label="5/5">★★★★★</span>
        <p class="rev-text">{t('rev.text1')}</p>
        <div class="rev-author"><div class="rev-avatar">M</div><div><p class="rev-name">Michael R.</p><p class="rev-source">{t('rev.src1')}</p></div></div>
      </div>
      <div class="rev-card reveal reveal-d2">
        <span class="rev-stars" aria-label="5/5">★★★★★</span>
        <p class="rev-text">{t('rev.text2')}</p>
        <div class="rev-author"><div class="rev-avatar">S</div><div><p class="rev-name">Sandra &amp; Klaus</p><p class="rev-source">{t('rev.src2')}</p></div></div>
      </div>
      <div class="rev-card reveal reveal-d3">
        <span class="rev-stars" aria-label="5/5">★★★★★</span>
        <p class="rev-text">{t('rev.text3')}</p>
        <div class="rev-author"><div class="rev-avatar">J</div><div><p class="rev-name">James T.</p><p class="rev-source">{t('rev.src3')}</p></div></div>
      </div>
    </div>
    <div class="scores-row reveal">
      <div class="score-item"><p class="score-num">8.6</p><p class="score-label">{t('score.overall')}</p></div>
      <div class="score-divider"></div>
      <div class="score-item"><p class="score-num">3.4k</p><p class="score-label">{t('score.total')}</p></div>
      <div class="score-divider"></div>
      <div class="score-item"><p class="score-num">9.0</p><p class="score-label">{t('score.staff')}</p></div>
      <div class="score-divider"></div>
      <div class="score-item"><p class="score-num">9.2</p><p class="score-label">{t('score.clean')}</p></div>
    </div>
  </div>
</section>

<!-- RESERVE · tabla de tarifas estática (sin disponibilidad simulada, brief §4) -->
<section class="section" id="reserve">
  <div class="container">
    <div class="reserve-inner">
      <div class="reserve-cta reveal">
        <p class="section-eyebrow">{t('reserve.eyebrow')}</p>
        <h2>{t('reserve.title.a')}<em>{t('reserve.title.b')}</em></h2>
        <p>{t('reserve.desc')}</p>
        <a class="btn btn-primary" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">{t('reserve.book')}</a>
      </div>
      <div class="reveal reveal-d2">
        <table class="rate-table">
          <thead>
            <tr>
              <th>{t('reserve.tbl.room')}</th>
              <th style="text-align:right">{t('reserve.tbl.rack')}</th>
              <th style="text-align:right">{t('reserve.tbl.promo')}</th>
            </tr>
          </thead>
          <tbody>
            {rooms.map((r) => (
              <tr>
                <td>{t(`rooms.${r.key}` as any)}</td>
                <td style="text-align:right"><span class="rate-rack">${t(`rooms.${r.key}.rack` as any)}</span></td>
                <td class="rate-price">${t(`rooms.${r.key}.promo` as any)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  // ── Slider de habitaciones ──────────────────────────────────────────
  (function () {
    const track = document.getElementById('roomsTrack') as HTMLElement | null;
    const dotsWrap = document.getElementById('roomsDots') as HTMLElement | null;
    const prev = document.getElementById('roomsPrev') as HTMLButtonElement | null;
    const next = document.getElementById('roomsNext') as HTMLButtonElement | null;
    if (!track || !dotsWrap || !prev || !next) return;

    const cards = Array.from(track.children) as HTMLElement[];
    const total = cards.length;
    let current = 0;

    // Cuántas tarjetas caben visibles según el ancho
    function perView() {
      return window.innerWidth <= 860 ? 1 : 3;
    }

    // Máximo índice al que podemos llegar (sin dejar espacio vacío)
    function maxIndex() { return Math.max(0, total - perView()); }

    // Crea los dots
    function buildDots() {
      dotsWrap.innerHTML = '';
      const steps = maxIndex() + 1;
      for (let i = 0; i < steps; i++) {
        const d = document.createElement('button');
        d.className = 'slider-dot' + (i === 0 ? ' active' : '');
        d.setAttribute('aria-label', `Habitación ${i + 1}`);
        d.addEventListener('click', () => goTo(i));
        dotsWrap.appendChild(d);
      }
    }

    function goTo(idx: number) {
      current = Math.max(0, Math.min(idx, maxIndex()));
      // El ancho de una tarjeta = ancho total / perView (aprox)
      const cardW = cards[0].offsetWidth + 1; // +1 por el gap de 1px
      track.style.transform = `translateX(-${current * cardW}px)`;
      // Actualizar dots
      dotsWrap.querySelectorAll('.slider-dot').forEach((d, i) =>
        d.classList.toggle('active', i === current)
      );
      prev.disabled = current === 0;
      next.disabled = current >= maxIndex();
    }

    prev.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));

    // Touch/swipe
    let startX = 0;
    track.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) goTo(dx < 0 ? current + 1 : current - 1);
    });

    buildDots();
    goTo(0);
    window.addEventListener('resize', () => { buildDots(); goTo(Math.min(current, maxIndex())); });
  })();
</script>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const reveals = document.querySelectorAll('.reveal');
  if (reduce) {
    reveals.forEach((el) => el.classList.add('visible'));
  } else {
    const ro = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); } });
    }, { threshold: 0.12 });
    reveals.forEach((el) => ro.observe(el));

    const stats = document.getElementById('stats');
    let done = false;
    const so = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !done) {
          done = true;
          document.querySelectorAll('.num[data-count]').forEach((el) => {
            const target = parseInt((el as HTMLElement).dataset.count || '0', 10);
            const start = performance.now();
            const tick = (now: number) => {
              const p = Math.min(1, (now - start) / 1600);
              el.textContent = String(Math.round(p * target));
              if (p < 1) requestAnimationFrame(tick); else el.textContent = String(target);
            };
            requestAnimationFrame(tick);
          });
          if (stats) so.unobserve(stats);
        }
      });
    }, { threshold: 0.5 });
    if (stats) so.observe(stats);
  }
</script>
