---
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
import Ubicacion from './sections/Ubicacion.astro';
import Promotions from './sections/Promotions.astro';
import DateBar from './booking/DateBar.astro';
import { useTranslations, BOOKING_URL } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/home.css';

// Slots de imagen gestionados por el editor de fotos (npm run editor).
import heroImg from '../assets/images/slots/hero.jpeg';
import aboutImg from '../assets/images/slots/about.jpeg';
import kingImg from '../assets/images/slots/room-standard.jpeg';
import queenImg from '../assets/images/slots/room-deluxe.jpeg';
import execImg from '../assets/images/slots/room-exec.jpeg';
import cornerImg from '../assets/images/slots/room-corner.jpeg';

// Galerías de habitaciones — fotos reales por tipo
import king1 from '../assets/images/rooms/king/1.jpg';
import king2 from '../assets/images/rooms/king/2.jpg';
import king3 from '../assets/images/rooms/king/3.jpg';
import king4 from '../assets/images/rooms/king/4.jpg';
import queen1 from '../assets/images/rooms/queen/1.jpg';
import queen2 from '../assets/images/rooms/queen/2.jpg';
import queen3 from '../assets/images/rooms/queen/3.jpg';
import queen4 from '../assets/images/rooms/queen/4.jpg';
import exec1 from '../assets/images/rooms/exec/1.jpg';
import exec2 from '../assets/images/rooms/exec/2.jpg';
import exec3 from '../assets/images/rooms/exec/3.jpg';
import corner1 from '../assets/images/rooms/corner/1.jpg';
import corner2 from '../assets/images/rooms/corner/2.jpg';
import corner3 from '../assets/images/rooms/corner/3.jpg';
import corner4 from '../assets/images/rooms/corner/4.jpg';

const lang = Astro.props.lang as Lang;
const t = useTranslations(lang);

const amenities = ['pool', 'fitness', 'dining', 'business', 'parking', 'wifi', 'transfer', 'concierge'] as const;
const rooms = [
  { key: 'king',   img: king1,   badge: false, gallery: [king1, king2, king3, king4] },
  { key: 'queen',  img: queen1,  badge: false, gallery: [queen1, queen2, queen3, queen4] },
  { key: 'exec',   img: exec1,   badge: false, gallery: [exec1, exec2, exec3] },
  { key: 'corner', img: corner1, badge: true,  gallery: [corner1, corner2, corner3, corner4] },
];
// Comodidades comunes a todas las habitaciones (CLAUDE.md §3)
const roomFeatures = ['tv', 'minibar', 'safe', 'wifi', 'bath', 'service'] as const;
---
<!-- PROMOCIONES — primera pieza visible bajo el encabezado -->
<Promotions lang={lang} />

<!-- HERO -->
<section class="hero" id="hero">
  <div class="hero-bg">
    <Image
      src={heroImg}
      alt={lang === 'es' ? 'Habitación con vista al skyline de Ciudad de Panamá' : 'Guest room overlooking the Panama City skyline'}
      loading="eager"
      fetchpriority="high"
      width={1600}
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      quality={65}
    />
  </div>
  <div class="hero-scrim"></div>
  <div class="hero-content">
    <p class="hero-eyebrow">{t('hero.eyebrow')}</p>
    <h1 class="hero-title">
      {t('hero.title.a')}<br />
      {lang === 'es' ? <>{t('hero.title.c')}<br /><em>{t('hero.title.b')}</em></> : <><em>{t('hero.title.b')}</em><br />{t('hero.title.c')}</>}
    </h1>
    <p class="hero-desc">{t('hero.desc')}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={BOOKING_URL} data-booking-link aria-describedby="booking-new-tab-note" target="_blank" rel="noopener noreferrer">{t('hero.book')}</a>
      <a class="btn btn-ghost" href="#about">{t('hero.discover')}</a>
    </div>
    <p class="cta-call-prompt">{t('cta.callPrompt')} <a href="tel:+5072806400">+507 280 6400</a></p>
  </div>
  <div class="hero-scroll">{t('hero.scroll')}</div>
</section>

<!-- BARRA DE FECHAS (deep link al motor e-gds) -->
<DateBar lang={lang} />
<DateBar lang={lang} sticky />

<!-- STATS (contadores animados — detalle de Stitch) -->
<div class="stats-bar" id="stats">
  <div class="stat-item"><div class="stat-num"><span class="num" data-count="60">60</span></div><div class="stat-label">{t('stat.rooms')}</div></div>
  <div class="stat-item"><div class="stat-num"><span class="num" data-count="24">24</span>h</div><div class="stat-label">{t('stat.access')}</div></div>
  <div class="stat-item"><div class="stat-num"><span class="num" data-count="22">22</span>km</div><div class="stat-label">{t('stat.airport')}</div></div>
  <div class="stat-item"><div class="stat-num">$<span class="num" data-count="113">113</span></div><div class="stat-label">{t('stat.night')}</div></div>
</div>

<!-- ROOMS — la decisión principal aparece antes que el contenido editorial -->
<section class="section" id="rooms">
  <div class="container">
    <div class="rooms-header">
      <div>
        <p class="section-eyebrow reveal">{t('rooms.eyebrow')}</p>
        <h2 class="section-title reveal">{t('rooms.title.a')}<em>{t('rooms.title.b')}</em></h2>
      </div>
      <p class="section-desc reveal">{t('rooms.desc')}</p>
    </div>
    <div class="rooms-slider-wrap reveal">
      <div
        class="rooms-track"
        id="roomsTrack"
        role="region"
        aria-roledescription={lang === 'es' ? 'carrusel' : 'carousel'}
        aria-label={t('rooms.carousel')}
        tabindex="0"
      >
        {rooms.map((r, index) => (
          <article class="room-card" data-room-index={index}>
            <div class="room-image">
              <Image
                src={r.img}
                alt={t('rooms.photoAlt')}
                loading="lazy"
                width={640}
                widths={[360, 480, 640]}
                sizes="(max-width:639px) 84vw, (max-width:1023px) 46vw, 31vw"
                quality={72}
              />
              {r.badge && <div class="room-badge gold">{t('rooms.badge')}</div>}
            </div>
            <div class="room-body">
              <p class="room-cat">{t(`rooms.${r.key}.cat` as any)}</p>
              <h3>{t(`rooms.${r.key}` as any)}</h3>
              <div class="meta">{t(`rooms.${r.key}.meta` as any)}</div>
              <div class="price">
                <span class="price-rack">${t(`rooms.${r.key}.rack` as any)}</span>
                <strong class="price-promo">${t(`rooms.${r.key}.promo` as any)}</strong>
                <span class="price-night">{t('rooms.night')}</span>
              </div>
              <span class="price-taxes">{t('rooms.taxes')}</span>
              <p class="price-cancel">{t('rooms.freeCancel')}</p>
              <button class="btn-room" type="button" data-room-open={r.key} aria-haspopup="dialog" aria-controls={`room-${r.key}`}>{t('rooms.details')}</button>
            </div>
          </article>
        ))}
      </div>
      <div class="slider-controls">
        <button class="slider-btn" id="roomsPrev" aria-label={t('rooms.prev')} type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="slider-dots" id="roomsDots"></div>
        <button class="slider-btn" id="roomsNext" aria-label={t('rooms.next')} type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
      <p class="sr-only" id="roomsStatus" aria-live="polite"></p>
    </div>
  </div>
</section>

<!-- FICHAS DE HABITACIÓN — overlay <dialog> nativo (foco, Escape y backdrop de serie) -->
{rooms.map((r) => (
  <dialog class="room-modal" id={`room-${r.key}`} aria-labelledby={`room-${r.key}-title`}>
    <div class="room-modal-inner">
      <button class="room-modal-close" type="button" data-room-close aria-label={t('rooms.close')}>
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>

      <div class="room-modal-gallery" data-gallery>
        <div class="room-modal-viewport" data-gallery-track>
          {r.gallery.map((img, gi) => (
            <figure class="room-modal-slide" data-gallery-slide aria-hidden={gi === 0 ? undefined : 'true'}>
              <Image src={img} alt={t('rooms.photoAlt')} loading="lazy" width={960} widths={[480, 720, 960]} sizes="(max-width:719px) 100vw, 52vw" quality={72} />
            </figure>
          ))}
        </div>
        {r.badge && <div class="room-badge gold">{t('rooms.badge')}</div>}
        {r.gallery.length > 1 && (
          <>
            <button class="gallery-btn gallery-btn--prev" type="button" data-gallery-prev aria-label={t('rooms.galPrev')}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button class="gallery-btn gallery-btn--next" type="button" data-gallery-next aria-label={t('rooms.galNext')}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
            <div class="gallery-dots" data-gallery-dots></div>
          </>
        )}
      </div>

      <div class="room-modal-body">
        <p class="room-cat">{t(`rooms.${r.key}.cat` as any)}</p>
        <h3 id={`room-${r.key}-title`}>{t(`rooms.${r.key}` as any)}</h3>

        <ul class="room-specs">
          <li><span>{t('rooms.spec.view')}</span><strong>{t(`rooms.${r.key}.view` as any)}</strong></li>
          <li><span>{t('rooms.spec.bed')}</span><strong>{t(`rooms.${r.key}.bed` as any)}</strong></li>
          <li><span>{t('rooms.spec.guests')}</span><strong>{t(`rooms.${r.key}.guests` as any)}</strong></li>
        </ul>

        <p class="room-modal-desc">{t(`rooms.${r.key}.desc` as any)}</p>

        <details class="room-acc" open>
          <summary>{t('rooms.amenTitle')}</summary>
          <ul class="room-feat-list">
            {roomFeatures.map((f) => <li>{t(`rooms.feat.${f}` as any)}</li>)}
          </ul>
        </details>

        <div class="room-modal-foot">
          <div>
            <div class="price">
              <span class="price-rack">${t(`rooms.${r.key}.rack` as any)}</span>
              <strong class="price-promo">${t(`rooms.${r.key}.promo` as any)}</strong>
              <span class="price-night">{t('rooms.night')}</span>
            </div>
            <p class="price-cancel">{t('rooms.freeCancel')}</p>
          </div>
          <a class="btn-room" href={BOOKING_URL} data-booking-link aria-describedby="booking-new-tab-note" target="_blank" rel="noopener noreferrer">{t('rooms.reserve')}</a>
        </div>
      </div>
    </div>
  </dialog>
))}

<!-- AMENITIES -->
<section class="section dark" id="amenities">
  <div class="container">
    <p class="section-eyebrow reveal">{t('amen.eyebrow')}</p>
    <h2 class="section-title reveal">{t('amen.title.a')}<em>{t('amen.title.b')}</em></h2>
    <p class="collection-hint">{t('carousel.hint')} <span aria-hidden="true">→</span></p>
    <ul class="amen-grid" aria-label={t('nav.amenities')}>
      {amenities.map((a, i) => (
        <li class={`amen-card reveal reveal-d${(i % 4) + 1}`}>
          <span class="icon"><Icon name={a} /></span>
          <h3>{t(`amen.${a}` as any)}</h3>
          <p>{t(`amen.${a}.d` as any)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ABOUT -->
<section class="section" id="about">
  <div class="container">
    <div class="about-inner">
      <div class="about-image reveal">
        <Image
          src={aboutImg}
          alt={lang === 'es' ? 'Lobby del Global Hotel Panamá' : 'Global Hotel Panama lobby'}
          loading="lazy"
          width={800}
          widths={[480, 640, 800]}
          sizes="(max-width:720px) 100vw, 46vw"
          quality={72}
        />
      </div>
      <div>
        <p class="section-eyebrow reveal">{t('about.eyebrow')}</p>
        <h2 class="section-title reveal">{t('about.title.a')}<em>{t('about.title.b')}</em></h2>
        <p class="section-desc reveal">{t('about.p1')}</p>
        <p class="section-desc about-desc-secondary reveal">{t('about.p2')}</p>
        <div class="about-details reveal">
          <div class="about-detail-item"><strong>{t('about.d1s')}</strong><span>{t('about.d1l')}</span></div>
          <div class="about-detail-item"><strong>{t('about.d2s')}</strong><span>{t('about.d2l')}</span></div>
          <div class="about-detail-item"><strong>{t('about.d3s')}</strong><span>{t('about.d3l')}</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- OFFERS -->
<section class="section dark" id="offers">
  <div class="container">
    <p class="section-eyebrow reveal">{t('offers.eyebrow')}</p>
    <h2 class="section-title reveal">{t('offers.title.a')}<em>{t('offers.title.b')}</em></h2>
    <p class="section-desc reveal">{t('offers.desc')}</p>
    <p class="collection-hint">{t('carousel.hint')} <span aria-hidden="true">→</span></p>
    <div class="offer-grid" role="region" aria-label={t('offers.eyebrow')} tabindex="0">
      <div class="offer-card reveal">
        <div class="offer-tag">{t('offer.ext.tag')}</div>
        <h3>{t('offer.ext.title')}</h3><p>{t('offer.ext.desc')}</p>
        <a class="btn-offer" href={BOOKING_URL} data-booking-link aria-describedby="booking-new-tab-note" target="_blank" rel="noopener noreferrer">{t('offer.book')}</a>
      </div>
      <div class="offer-card reveal reveal-d2">
        <div class="offer-tag">{t('offer.wknd.tag')}</div>
        <h3>{t('offer.wknd.title')}</h3><p>{t('offer.wknd.desc')}</p>
        <a class="btn-offer" href={BOOKING_URL} data-booking-link aria-describedby="booking-new-tab-note" target="_blank" rel="noopener noreferrer">{t('offer.book')}</a>
      </div>
      <div class="offer-card reveal reveal-d3">
        <div class="offer-tag">{t('offer.corp.tag')}</div>
        <h3>{t('offer.corp.title')}</h3><p>{t('offer.corp.desc')}</p>
        <a class="btn-offer" href={BOOKING_URL} data-booking-link aria-describedby="booking-new-tab-note" target="_blank" rel="noopener noreferrer">{t('offer.book')}</a>
      </div>
    </div>
  </div>
</section>

<!-- LOCATION · sección Ubicación aprobada (dirección con acción, distancias agrupadas, mapa diferido) -->
<Ubicacion lang={lang} />

<!-- VALORACIONES · solo cifras confirmadas; sin citas no verificadas. -->
<section class="section dark" id="reviews">
  <div class="container">
    <p class="section-eyebrow reveal">{t('rev.eyebrow')}</p>
    <h2 class="section-title reveal">{t('rev.title.a')}<em>{t('rev.title.b')}</em></h2>
    <div class="scores-row reveal">
      <div class="score-item"><p class="score-num">8.6</p><p class="score-label">{t('score.overall')}</p></div>
      <div class="score-divider"></div>
      <div class="score-item"><p class="score-num">3.4k</p><p class="score-label">{t('score.total')}</p></div>
      <div class="score-divider"></div>
      <div class="score-item"><p class="score-num">9.0</p><p class="score-label">{t('score.staff')}</p></div>
      <div class="score-divider"></div>
      <div class="score-item"><p class="score-num">9.2</p><p class="score-label">{t('score.clean')}</p></div>
    </div>
  </div>
</section>

<!-- RESERVE · beneficios de reserva directa (combinación A+C) -->
<section class="section dark" id="reserve">
  <div class="container">
    <div class="reserve-inner">
      <div class="reserve-cta reveal">
        <p class="section-eyebrow">{t('reserve.eyebrow')}</p>
        <h2>{t('reserve.title.a')}<em>{t('reserve.title.b')}</em></h2>
        <p>{t('reserve.desc')}</p>
        <a class="btn btn-primary" href={BOOKING_URL} data-booking-link aria-describedby="booking-new-tab-note" target="_blank" rel="noopener noreferrer">{t('reserve.book')}</a>
        <p class="cta-call-prompt">{t('cta.callPrompt')} <a href="tel:+5072806400">+507 280 6400</a></p>
      </div>
      <div class="reserve-benefits reveal reveal-d2">
        <p class="reserve-why">{t('reserve.why')}</p>
        {(['b1','b2','b3','b4'] as const).map((k) => (
          <div class="benefit-item">
            <span class="benefit-check" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.2"/><path d="M6 10l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div>
              <strong class="benefit-title">{t(`reserve.${k}.title` as any)}</strong>
              <p class="benefit-desc">{t(`reserve.${k}.desc` as any)}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // ── Slider de habitaciones ──────────────────────────────────────────
  (function () {
    const track = document.getElementById('roomsTrack') as HTMLElement | null;
    const dotsWrap = document.getElementById('roomsDots') as HTMLElement | null;
    const prev = document.getElementById('roomsPrev') as HTMLButtonElement | null;
    const next = document.getElementById('roomsNext') as HTMLButtonElement | null;
    const live = document.getElementById('roomsStatus');
    if (!track || !dotsWrap || !prev || !next || !live) return;

    const cards = [...track.querySelectorAll<HTMLElement>('.room-card')];
    const total = cards.length;
    const english = document.documentElement.lang === 'en';
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let scrollFrame = 0;

    function perView() {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 640) return 2;
      return 1;
    }

    function maxIndex() { return Math.max(0, total - perView()); }

    function positionFor(index: number) {
      const desired = cards[index].offsetLeft - track.offsetLeft;
      return Math.min(desired, track.scrollWidth - track.clientWidth);
    }

    function updateControls(index: number, announce = false) {
      current = Math.max(0, Math.min(index, maxIndex()));
      dotsWrap.querySelectorAll<HTMLButtonElement>('.slider-dot').forEach((dot, i) => {
        const active = i === current;
        dot.classList.toggle('active', active);
        dot.setAttribute('aria-current', active ? 'true' : 'false');
      });
      prev.disabled = current === 0;
      next.disabled = current >= maxIndex();
      if (announce) {
        live.textContent = english
          ? `Room ${current + 1} of ${total}`
          : `Habitación ${current + 1} de ${total}`;
      }
    }

    function buildDots() {
      dotsWrap.innerHTML = '';
      const steps = maxIndex() + 1;
      for (let i = 0; i < steps; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'slider-dot';
        dot.setAttribute('aria-label', english ? `Show room ${i + 1}` : `Mostrar habitación ${i + 1}`);
        dot.setAttribute('aria-controls', 'roomsTrack');
        dot.addEventListener('click', () => goTo(i));
        dotsWrap.appendChild(dot);
      }
      updateControls(Math.min(current, maxIndex()));
    }

    function goTo(index: number, behavior: ScrollBehavior = reduceMotion ? 'auto' : 'smooth') {
      const nextIndex = Math.max(0, Math.min(index, maxIndex()));
      track.scrollTo({ left: positionFor(nextIndex), behavior });
      updateControls(nextIndex, true);
    }

    prev.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(current + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(current - 1);
      }
    });

    track.addEventListener('scroll', () => {
      cancelAnimationFrame(scrollFrame);
      scrollFrame = requestAnimationFrame(() => {
        let closest = 0;
        let distance = Number.POSITIVE_INFINITY;
        for (let index = 0; index <= maxIndex(); index++) {
          const candidate = Math.abs(track.scrollLeft - positionFor(index));
          if (candidate < distance) {
            distance = candidate;
            closest = index;
          }
        }
        updateControls(closest);
      });
    });

    buildDots();
    goTo(0, 'auto');
    window.addEventListener('resize', () => {
      buildDots();
      goTo(Math.min(current, maxIndex()), 'auto');
    });
  })();

  // ── Fichas de habitación (overlay) ──────────────────────────────────
  (function () {
    const modals = [...document.querySelectorAll<HTMLDialogElement>('.room-modal')];
    if (!modals.length) return;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lastTrigger: HTMLElement | null = null;

    function openModal(key: string, trigger: HTMLElement) {
      const dialog = document.getElementById(`room-${key}`) as HTMLDialogElement | null;
      if (!dialog || typeof dialog.showModal !== 'function') return;
      lastTrigger = trigger;
      dialog.showModal();
      document.body.classList.add('booking-open');
    }

    function closeModal(dialog: HTMLDialogElement) {
      dialog.close();
    }

    document.querySelectorAll<HTMLElement>('[data-room-open]').forEach((btn) => {
      btn.addEventListener('click', () => openModal(btn.dataset.roomOpen || '', btn));
    });

    modals.forEach((dialog) => {
      dialog.querySelector<HTMLButtonElement>('[data-room-close]')?.addEventListener('click', () => closeModal(dialog));
      // clic en el backdrop (fuera del contenido) cierra
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeModal(dialog);
      });
      dialog.addEventListener('close', () => {
        if (!document.querySelector<HTMLDialogElement>('.room-modal[open]')) {
          document.body.classList.remove('booking-open');
        }
        lastTrigger?.focus({ preventScroll: true });
        lastTrigger = null;
      });

      // Galería interna
      const track = dialog.querySelector<HTMLElement>('[data-gallery-track]');
      const slides = [...dialog.querySelectorAll<HTMLElement>('[data-gallery-slide]')];
      if (!track || slides.length <= 1) return;
      let index = 0;
      const dotsWrap = dialog.querySelector<HTMLElement>('[data-gallery-dots]');
      // Crear dots
      slides.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'gallery-dot';
        dot.setAttribute('aria-label', `Foto ${i + 1}`);
        dot.addEventListener('click', () => show(i));
        dotsWrap?.appendChild(dot);
      });
      const dots = [...(dotsWrap?.querySelectorAll<HTMLButtonElement>('.gallery-dot') ?? [])];
      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        track.style.transform = `translateX(-${index * 100}%)`;
        slides.forEach((slide, i) => slide.setAttribute('aria-hidden', i === index ? 'false' : 'true'));
        dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
      };
      track.style.transition = reduceMotion ? 'none' : 'transform .45s cubic-bezier(.4,0,.2,1)';
      show(0);
      dialog.querySelector<HTMLButtonElement>('[data-gallery-prev]')?.addEventListener('click', () => show(index - 1));
      dialog.querySelector<HTMLButtonElement>('[data-gallery-next]')?.addEventListener('click', () => show(index + 1));
    });
  })();

  // ── Slider de promociones (cerca del hero) ──────────────────────────
  (function () {
    const band = document.querySelector<HTMLElement>('[data-promo]');
    const track = band?.querySelector<HTMLElement>('[data-promo-track]');
    const dotsWrap = band?.querySelector<HTMLElement>('[data-promo-dots]');
    if (!band || !track || !dotsWrap) return;
    const slides = [...track.querySelectorAll<HTMLElement>('[data-promo-slide]')];
    if (slides.length <= 1) return;
    const english = document.documentElement.lang === 'en';
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer = 0;

    track.style.transition = reduceMotion ? 'none' : 'transform .5s ease';
    slides.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'promo-dot';
      dot.setAttribute('aria-label', english ? `Show offer ${i + 1}` : `Mostrar oferta ${i + 1}`);
      dot.setAttribute('aria-controls', 'promos');
      dot.addEventListener('click', () => { go(i); restart(); });
      dotsWrap.appendChild(dot);
    });
    const dots = [...dotsWrap.querySelectorAll<HTMLButtonElement>('.promo-dot')];

    function go(next: number) {
      index = (next + slides.length) % slides.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((slide, i) => { slide.inert = i !== index; });
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index);
        dot.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
    }

    function stop() { if (timer) { clearInterval(timer); timer = 0; } }
    function restart() {
      // Rota salvo bajo "reducir movimiento"; se pausa con el cursor o el foco.
      stop();
      if (reduceMotion) return;
      timer = window.setInterval(() => go(index + 1), 7000);
    }

    band.addEventListener('mouseenter', stop);
    band.addEventListener('mouseleave', restart);
    band.addEventListener('focusin', stop);
    band.addEventListener('focusout', restart);

    go(0);
    restart();
  })();
</script>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const reveals = document.querySelectorAll('.reveal');
  document.documentElement.classList.add('reveal-ready');
  if (reduce) {
    reveals.forEach((el) => el.classList.add('visible'));
  } else {
    const ro = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); } });
    }, { threshold: 0.12 });
    reveals.forEach((el) => ro.observe(el));

    const stats = document.getElementById('stats');
    let done = false;
    const so = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !done) {
          done = true;
          document.querySelectorAll('.num[data-count]').forEach((el) => {
            const target = parseInt((el as HTMLElement).dataset.count || '0', 10);
            const start = performance.now();
            const tick = (now: number) => {
              const p = Math.min(1, (now - start) / 1600);
              el.textContent = String(Math.round(p * target));
              if (p < 1) requestAnimationFrame(tick); else el.textContent = String(target);
            };
            requestAnimationFrame(tick);
          });
          if (stats) so.unobserve(stats);
        }
      });
    }, { threshold: 0.5 });
    if (stats) so.observe(stats);
  }
</script>
