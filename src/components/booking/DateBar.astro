---
// Barra de fechas. Recoge entrada/salida/huéspedes y abre el motor e-gds con la
// búsqueda prefijada (deep link vía buildBookingUrl). No procesa reservas aquí.
// Se renderiza dos veces: la barra bajo el hero y una versión sticky al hacer scroll.
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
const lang = Astro.props.lang as Lang;
const sticky = Astro.props.sticky as boolean | undefined;
const t = useTranslations(lang);
const wrapClass = sticky ? 'sticky-bar' : 'date-bar-wrap';
const idPrefix = sticky ? 'sticky' : 'date';
---
<div class={wrapClass} id={sticky ? 'stickyBar' : 'dateSection'} data-book-bar>
  <div class={sticky ? 'sticky-inner' : 'date-bar-inner'}>
    <div class="date-field">
      <label for={`${idPrefix}-checkin`}>{t('book.checkin')}</label>
      <input type="date" id={`${idPrefix}-checkin`} data-field="checkin" />
    </div>
    <div class="date-field">
      <label for={`${idPrefix}-checkout`}>{t('book.checkout')}</label>
      <input type="date" id={`${idPrefix}-checkout`} data-field="checkout" />
    </div>
    <div class="date-field">
      <label for={`${idPrefix}-guests`}>{t('book.guests')}</label>
      <select id={`${idPrefix}-guests`} data-field="guests">
        <option value="1">{t('book.guest1')}</option>
        <option value="2" selected>{t('book.guest2')}</option>
        <option value="3">{t('book.guest3')}</option>
        <option value="4">{t('book.guest4')}</option>
      </select>
    </div>
    <button type="button" class={sticky ? 'btn-sticky' : 'btn-date'} data-book-submit>
      {sticky ? t('book.searchShort') : t('book.search')}
    </button>
  </div>
</div>

<script>
  import { buildBookingUrl } from './buildBookingUrl';

  const today = new Date().toISOString().slice(0, 10);

  document.querySelectorAll<HTMLElement>('[data-book-bar]').forEach((bar) => {
    const checkin = bar.querySelector<HTMLInputElement>('[data-field=checkin]')!;
    const checkout = bar.querySelector<HTMLInputElement>('[data-field=checkout]')!;
    const guests = bar.querySelector<HTMLSelectElement>('[data-field=guests]')!;
    const submit = bar.querySelector<HTMLButtonElement>('[data-book-submit]')!;

    checkin.min = today;
    checkout.min = today;

    // La salida no puede ser anterior o igual a la entrada.
    checkin.addEventListener('change', () => {
      if (!checkin.value) return;
      const next = new Date(checkin.value);
      next.setDate(next.getDate() + 1);
      const min = next.toISOString().slice(0, 10);
      checkout.min = min;
      if (checkout.value && checkout.value <= checkin.value) checkout.value = min;
    });

    submit.addEventListener('click', () => {
      const url = buildBookingUrl({
        checkIn: checkin.value || undefined,
        checkOut: checkout.value || undefined,
        guests: Number(guests.value) || undefined,
      });
      // Abrir como enlace real (una pestaña). window.open con opciones lo bloquean los popup blockers.
      const a = document.createElement('a');
      a.href = url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      document.body.appendChild(a);
      a.click();
      a.remove();
    });
  });

  // La barra sticky aparece cuando el hero sale de la vista.
  const stickyBar = document.getElementById('stickyBar');
  const hero = document.getElementById('hero');
  if (stickyBar && hero) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => stickyBar.classList.toggle('visible', !e.isIntersecting)),
      { threshold: 0 }
    );
    obs.observe(hero);
  }
</script>
