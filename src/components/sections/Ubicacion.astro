---
// Sección Ubicación — portada de referencia/propuestas/seccion-ubicacion.html (dirección aprobada).
// La dirección sale de la lista y lleva su propia acción. Números en columna con tabular-nums,
// iconos que significan algo. Fachada de mapa dibujada; el iframe de Google se difiere hasta pedirlo.
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
const lang = Astro.props.lang as Lang;
const t = useTranslations(lang);
const dirUrl = 'https://www.google.com/maps/dir/?api=1&destination=Global+Hotel+Panama+Obarrio';
---
<section class="ubicacion" id="location" aria-labelledby="ubicacion-titulo">
  <div class="container">
    <div class="ubi-grid">
      <!-- COLUMNA DE DATOS -->
      <div class="col-datos">
        <p class="section-eyebrow reveal">{t('ubi.eyebrow')}</p>
        <h2 class="section-title reveal" id="ubicacion-titulo">{t('ubi.title.a')}<em>{t('ubi.title.b')}</em></h2>
        <p class="ubi-intro reveal">{t('ubi.intro')}</p>

        <!-- Dirección: dato de otra naturaleza, con su propia acción -->
        <div class="direccion reveal">
          <p class="etiqueta">{t('ubi.addr.label')}</p>
          <address>{t('ubi.addr.l1')}<span>{t('ubi.addr.l2')}</span></address>
          <div class="acciones">
            <a class="ubi-btn ubi-btn-solido" href={dirUrl} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8-8-2z"/></svg>{t('ubi.directions')}
            </a>
            <a class="ubi-btn ubi-btn-linea" href="tel:+5072806400">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .3 1.9.6 2.8a2 2 0 01-.4 2.1L8.1 9.9a16 16 0 006 6l1.3-1.2a2 2 0 012.1-.5c.9.3 1.8.5 2.8.6a2 2 0 011.7 2z"/></svg>+507 280 6400
            </a>
          </div>
        </div>

        <!-- Distancias en coche -->
        <div class="grupo reveal">
          <h3 class="grupo-titulo">{t('ubi.group.car')}</h3>
          <ul>
            <li class="lugar">
              <svg class="lugar-icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.8 19.8L16 14l-2-1 3-6 4 4h2M4 4l3 3M9 3l3 3M2 12h8l4 5"/></svg>
              <p class="lugar-dato">20 <small>{t('ubi.min')}</small></p>
              <p class="lugar-nombre">{t('ubi.tocumen')}<small>{t('ubi.tocumen.s')}</small></p>
            </li>
            <li class="lugar">
              <svg class="lugar-icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6M9 11h.01M15 11h.01"/></svg>
              <p class="lugar-dato">10 <small>{t('ubi.min')}</small></p>
              <p class="lugar-nombre">{t('ubi.casco')}<small>{t('ubi.casco.s')}</small></p>
            </li>
            <li class="lugar">
              <svg class="lugar-icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 17c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 12c2-2 4-2 6 0s4 2 6 0 4-2 6 0M6 7l6-4 6 4"/></svg>
              <p class="lugar-dato">2 <small>{t('ubi.km')}</small></p>
              <p class="lugar-nombre">{t('ubi.balboa')}<small>{t('ubi.balboa.s')}</small></p>
            </li>
            <li class="lugar">
              <svg class="lugar-icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22V12M12 12c0-4 3-7 7-7 0 4-3 7-7 7zM12 12c0-3.5-2.6-6-6-6 0 3.5 2.6 6 6 6z"/></svg>
              <p class="lugar-dato">4.4 <small>{t('ubi.km')}</small></p>
              <p class="lugar-nombre">{t('ubi.metropolitano')}</p>
            </li>
          </ul>
        </div>

        <!-- Distancias a pie · TODO(juan): verificar "Soho Mall misma cuadra" y "Línea 1" antes de publicar -->
        <div class="grupo reveal">
          <h3 class="grupo-titulo">{t('ubi.group.walk')}</h3>
          <ul>
            <li class="lugar">
              <svg class="lugar-icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h2l1 11h11M9 20a1 1 0 100-2 1 1 0 000 2zM18 20a1 1 0 100-2 1 1 0 000 2zM7 8h13l-1.5 7"/></svg>
              <p class="lugar-dato aprox">{t('ubi.near')}</p>
              <p class="lugar-nombre">{t('ubi.super')}<small>{t('ubi.super.s')}</small></p>
            </li>
            <li class="lugar">
              <svg class="lugar-icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="13" rx="2"/><path d="M5 9h14M8 20l-2 2M16 20l2 2M9 13h.01M15 13h.01"/></svg>
              <p class="lugar-dato aprox">{t('ubi.close')}</p>
              <p class="lugar-nombre">{t('ubi.metro')}<small>{t('ubi.metro.s')}</small></p>
            </li>
          </ul>
        </div>
      </div>

      <!-- COLUMNA DEL MAPA: iframe real de Google + marcador pulsante + CTA direcciones -->
      <div class="col-mapa">
        <div class="mapa">
          <div class="mapa-marco">
            <!-- Mapa real de Google, zoom 15 = muestra el vecindario de Obarrio -->
            <iframe
              class="mapa-iframe"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3972.7!2d-79.524!3d8.9848!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8faca8fb5412501b%3A0xfcd06db566124035!2sGlobal%20Hotel%20Panama!5e0!3m2!1ses!2spa!4v1777669639564!5m2!1ses!2spa"
              title={t('ubi.map.iframe')}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>

            <!-- Marcador pulsante sobre el iframe (pointer-events:none = no bloquea el mapa) -->
            <div class="mapa-marker" aria-hidden="true">
              <svg viewBox="0 0 40 40" class="marker-svg">
                <circle class="pulso" cx="20" cy="20" r="14" fill="#B8965A" opacity=".5"/>
                <circle cx="20" cy="20" r="7" fill="#B8965A"/>
                <circle cx="20" cy="20" r="2.8" fill="#1C1C1C"/>
              </svg>
              <span class="marker-label">Global Hotel Panamá</span>
            </div>

            <!-- Degradado inferior para el CTA -->
            <div class="mapa-velo" aria-hidden="true"></div>

            <!-- CTA: abre direcciones en Google Maps -->
            <a class="mapa-cta" href={dirUrl} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8-8-2z"/></svg>
              {t('ubi.directions')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .ubicacion { padding: 100px 0; background: var(--ivory); }
  .ubi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  .ubi-intro { font-size: 17px; font-weight: 300; color: var(--mid); max-width: 46ch; margin: 0 0 44px; line-height: 1.8; }
  .direccion { border-top: 1px solid var(--charcoal); border-bottom: 1px solid rgba(28,28,28,.10); padding: 26px 0 28px; margin-bottom: 40px; }
  .direccion .etiqueta { font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: .18em; color: var(--soft); margin-bottom: 10px; }
  .direccion address { font-style: normal; font-family: var(--font-display); font-size: 25px; font-weight: 400; line-height: 1.35; margin-bottom: 22px; }
  .direccion address span { display: block; color: var(--mid); font-size: 19px; }
  .acciones { display: flex; gap: 12px; flex-wrap: wrap; }
  .ubi-btn { display: inline-flex; align-items: center; gap: 9px; font-family: var(--font-body); font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: .14em; padding: 15px 26px; border: 1px solid transparent; transition: background .25s, color .25s, border-color .25s; }
  .ubi-btn svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 1.4; fill: none; flex-shrink: 0; }
  .ubi-btn-solido { background: var(--gold); color: var(--charcoal); }
  .ubi-btn-solido:hover { background: var(--charcoal); color: var(--gold); }
  .ubi-btn-linea { background: transparent; color: var(--charcoal); border-color: var(--charcoal); }
  .ubi-btn-linea:hover { background: var(--charcoal); color: var(--ivory); }
  .grupo + .grupo { margin-top: 34px; }
  .grupo-titulo { display: flex; align-items: center; gap: 14px; font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: .18em; color: var(--soft); margin: 0 0 6px; font-family: var(--font-body); }
  .grupo-titulo::after { content: ""; flex: 1; height: 1px; background: rgba(28,28,28,.10); }
  .grupo ul { list-style: none; margin: 0; padding: 0; }
  .lugar { display: grid; grid-template-columns: 26px 84px 1fr; gap: 16px; align-items: baseline; padding: 15px 0; border-bottom: 1px solid rgba(28,28,28,.10); }
  .lugar-icono { align-self: center; width: 22px; height: 22px; stroke: var(--gold); stroke-width: 1.3; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .lugar-dato { text-align: right; font-variant-numeric: tabular-nums; font-size: 19px; font-weight: 400; line-height: 1.2; letter-spacing: -.01em; margin: 0; }
  .lugar-dato small { display: block; font-size: 10px; font-weight: 400; text-transform: uppercase; letter-spacing: .12em; color: var(--soft); margin-top: 3px; }
  .lugar-dato.aprox { font-family: var(--font-display); font-size: 20px; font-style: italic; color: var(--mid); }
  .lugar-nombre { font-size: 15px; font-weight: 400; line-height: 1.45; margin: 0; }
  .lugar-nombre small { display: block; font-size: 13px; color: var(--soft); margin-top: 2px; }
  /* Mapa */
  .mapa { position: sticky; top: 110px; }
  .mapa-marco { position: relative; aspect-ratio: 4/5; background: var(--charcoal); overflow: hidden; border: 1px solid rgba(28,28,28,.15); }
  .mapa-iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }

  /* Marcador pulsante — pointer-events none para no bloquear el mapa */
  .mapa-marker { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -60%); pointer-events: none; display: flex; flex-direction: column; align-items: center; gap: 6px; z-index: 2; }
  .marker-svg { width: 48px; height: 48px; filter: drop-shadow(0 2px 8px rgba(0,0,0,.45)); }
  .marker-label { font-family: var(--font-display); font-size: 15px; font-style: italic; color: var(--white); white-space: nowrap; text-shadow: 0 1px 6px rgba(0,0,0,.7); background: rgba(28,28,28,.55); padding: 3px 10px; }
  .pulso { transform-box: fill-box; transform-origin: center; animation: pulso 2.6s ease-out infinite; }
  @keyframes pulso { 0% { transform: scale(.65); opacity: .65; } 70% { transform: scale(2.5); opacity: 0; } 100% { transform: scale(2.5); opacity: 0; } }

  /* Degradado inferior */
  .mapa-velo { position: absolute; bottom: 0; left: 0; right: 0; height: 100px; background: linear-gradient(to bottom, transparent 0%, rgba(28,28,28,.75) 100%); pointer-events: none; z-index: 2; }

  /* CTA Cómo llegar — siempre visible en la parte inferior */
  .mapa-cta { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 3; display: inline-flex; align-items: center; gap: 9px; background: var(--gold); color: var(--charcoal); font-family: var(--font-body); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .14em; padding: 13px 24px; white-space: nowrap; transition: background .25s, transform .25s; }
  .mapa-cta svg { width: 15px; height: 15px; stroke: currentColor; stroke-width: 1.5; fill: none; flex-shrink: 0; }
  .mapa-cta:hover { background: var(--charcoal); color: var(--gold); transform: translateX(-50%) translateY(-2px); }
  @media (max-width: 1000px) {
    .ubicacion { padding: 80px 0; }
    .ubi-grid { grid-template-columns: 1fr; gap: 52px; }
    .col-datos { order: 1; } .col-mapa { order: 2; }
    .mapa { position: static; }
    .mapa-marco { aspect-ratio: 4/3; }
    .lugar { grid-template-columns: 22px 72px 1fr; gap: 12px; }
    .acciones .ubi-btn { flex: 1 1 auto; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .pulso { animation: none; } }
</style>
