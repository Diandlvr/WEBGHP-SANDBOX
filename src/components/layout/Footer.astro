---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
const lang = Astro.props.lang as Lang;
const t = useTranslations(lang);
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo">Global <span class="logo-accent">Hotel</span> Panamá</div>
        <p>{t('footer.brand')}</p>
      </div>
      <div class="footer-col">
        <h4>{t('footer.hotel')}</h4>
        <ul>
          <li><a href="#about">{t('footer.about')}</a></li>
          <li><a href="#amenities">{t('nav.amenities')}</a></li>
          <li><a href="#rooms">{t('nav.rooms')}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t('footer.services')}</h4>
        <ul>
          <li><a href="#reserve">{t('footer.reservations')}</a></li>
          <li><a href="#location">{t('nav.location')}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t('footer.contact')}</h4>
        <ul>
          <li>Calle 54 Este & Av. Samuel Lewis</li>
          <li>Obarrio, Ciudad de Panamá</li>
          <li><a href="tel:+5072806400">+507 280 6400</a></li>
          <li><a href="mailto:reception@globalhotelpanama.com"> reception@globalhotelpanama.com</a></li>
          <li><a href="mailto:reservations@globalhotelpanama.com"> reservations@globalhotelpanama.com</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{t('footer.rights')}</span>
    </div>
  </div>
</footer>
